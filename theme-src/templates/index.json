    "spadra_timeline": {
      "type": "glp1-timeline",
      "blocks": {
        "week_1": {
          "type": "milestone",
          "settings": {
            "period": "Week 1",
            "heading": "Initiation & Physiologic Adaptation",
            "detail": "Begin your protocol and allow your body to enter a period of gentle adaptation. Focus on consistency, timing, and establishing a stable daily cadence."
          }
        },
        "week_2": {
          "type": "milestone",
          "settings": {
            "period": "Week 2",
            "heading": "Consolidation of Routine",
            "detail": "At this stage, the protocol should begin to feel more familiar. Continue with steady adherence, reinforcing behavioral consistency and supporting physiologic normalization."
          }
        },
        "week_3_4": {
          "type": "milestone",
          "settings": {
            "period": "Weeks 3–4",
            "heading": "Find Your Rhythm",
            "detail": "Continue following your protocol and build on the consistency you've established. Use this time to evaluate your routine, track how you're feeling, and stay focused on your goals."
          }
        },
        "day_30": {
          "type": "milestone",
          "settings": {
            "period": "Day 30",
            "heading": "Clinical Review & Forward Planning",
            "detail": "You have completed the initial 30-day cycle. At this point, evaluate your subjective experience, adherence quality, and alignment with your intended outcomes. Use these insights to determine the appropriate next phase of your SPADRA protocol."
          }
        }
      },
      "block_order": [
        "week_1",
        "week_2",
        "week_3_4",
        "day_30"
      ],
      "settings": {
        "title": "Your First 30 Days",
        "background_color": "#ffffff"
      }
    },
