    "spadra_faq": {
      "type": "found-faq",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "Is SPADRA a replacement for my prescription medication?",
            "answer": "<p>No. SPADRA supplement packs are not a substitute for prescription medication and should be used with your healthcare provider. They are not intended to diagnose, treat, cure, or prevent any disease.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "What is OKCapsule?",
            "answer": "<p>OKCapsule is our supplement manufacturing and pre-sort packaging partner. Every SPADRA pouch is filled and sealed by OKCapsule so your daily dose is accurate and ready to go.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "How do I know which pack is right for me?",
            "answer": "<p>Take the four-question Find Your Protocol assessment for an informational recommendation, or browse every protocol directly. If you're unsure, check with your provider.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "How long does one pack last?",
            "answer": "<p>Every protocol ships as a 30-day supply — one pre-sorted pouch per day. Orders are one-time purchases today; recurring delivery is not available yet, so reorder whenever you're ready for the next cycle.</p>"
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "Are these products FDA approved?",
            "answer": "<p>SPADRA products are dietary supplements. These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</p>"
          }
        }
      },
      "block_order": [
        "faq_1",
