    "spadra_how_it_works": {
      "type": "found-how-it-works",
      "settings": {
        "title": "How It Works",
        "step_1_heading": "Initiate Your Protocol",
        "step_1_detail": "Your protocol is designed as a structured, nature-aligned regimen tailored to your selected goals, preferences, and daily physiology. Begin by following your prescribed schedule with consistency, allowing your system time to adapt and establish baseline equilibrium.",
        "step_2_heading": "Establish Daily Integration",
        "step_2_detail": "The primary objective during this phase is adherence and integration. Incorporate your protocol into your existing daily routine in a way that is sustainable, predictable, and minimally disruptive. Consistency is more important than intensity.",
        "step_3_heading": "Observe, Stabilize, Refine",
        "step_3_detail": "As you progress through the month, observe how your routine interacts with your energy, digestion, recovery, and overall daily function. Maintain what is working well, make measured adjustments when necessary, and remain anchored to your long-term objectives.",
        "background_color": "#ffffff"
      }
    },
