{%- comment -%}
  SPADRA "Find Your Protocol" quiz.
  Rendered once globally from layout/theme.liquid. Opened by any
  [data-spadra-quiz-open] trigger via the global handler in theme.liquid,
  which calls showModal() on #spadra-quiz-modal.

  Multi-select: the three scoring questions accept several answers. Picking more
  goals must broaden the result set, not let one question outweigh the others,
  so a question's weight is divided across however many options were chosen —
  selecting three goals gives each a third of that question's influence rather
  than tripling the question.

  Results are built goal-first: each goal the shopper selected contributes its
  own best-scoring protocol before the ranking fills the remaining slots, so
  three stated goals return three different protocols rather than four variants
  of the loudest one.

  The catalogue comes from snippets/spadra-quiz-catalog.liquid. It is not built
  inline here any more: the old `concat` chain over seven collections silently
  yielded a fraction of the catalogue, and a shopper who picked three goals got
  one protocol back. The results copy below is also written so it can never
  claim more protocols than it actually shows.

  Results are written to sessionStorage['spadraQuizMatches'] as an array of
  handles; sections/spadra-pdp.liquid reads that to personalise "You May Also Like".
{%- endcomment -%}

<dialog id="spadra-quiz-modal" class="spadra-quiz" aria-labelledby="spadra-quiz-title"
  data-specialist-name="{{ section.settings.specialist_name | default: 'Bobbin' | escape }}">
  <form method="dialog" class="spadra-quiz__close-form">
    <button class="spadra-quiz__close" aria-label="Close">&times;</button>
  </form>

  <div class="spadra-quiz__inner" data-quiz-root>
    <header class="spadra-quiz__header">
      <p class="spadra-quiz__eyebrow">Find Your Protocol</p>
      <h2 class="spadra-quiz__title" id="spadra-quiz-title" data-quiz-heading>A few quick questions. About thirty seconds.</h2>
      <div class="spadra-quiz__progress" data-quiz-progress-wrap>
        <div class="spadra-quiz__progress-bar"><span data-quiz-progress-fill></span></div>
        <p class="spadra-quiz__progress-text" data-quiz-progress-text>Question 1 of 5</p>
      </div>
    </header>

    <div class="spadra-quiz__body" data-quiz-body aria-live="polite"></div>

    <footer class="spadra-quiz__footer">
      <button type="button" class="spadra-quiz__back" data-quiz-back hidden>&larr; Back</button>
      <a class="spadra-quiz__skip" href="/collections/all">Skip and browse all protocols</a>
    </footer>

    <p class="spadra-quiz__legal">
      This assessment is informational and does not diagnose any condition or replace advice from your
      healthcare provider. These statements have not been evaluated by the Food and Drug Administration.
      This product is not intended to diagnose, treat, cure, or prevent any disease.
    </p>
  </div>

  {%- if section.settings.specialist_enabled -%}
    {%- render 'spadra-specialist-match' -%}
  {%- endif -%}

  {%- render 'spadra-quiz-catalog' -%}
  {%- render 'spadra-ingredient-images', as_json: true -%}
  {%- render 'spadra-stack-discounts' -%}
</dialog>

<script>
  (function () {
    var modal = document.getElementById('spadra-quiz-modal');
    if (!modal) return;

    var root = modal.querySelector('[data-quiz-root]');
    var body = modal.querySelector('[data-quiz-body]');
    var heading = modal.querySelector('[data-quiz-heading]');
    var backBtn = modal.querySelector('[data-quiz-back]');
    var progressWrap = modal.querySelector('[data-quiz-progress-wrap]');
    var progressFill = modal.querySelector('[data-quiz-progress-fill]');
    var progressText = modal.querySelector('[data-quiz-progress-text]');
    var catalogEl = modal.querySelector('[data-quiz-catalog]');
    var specialistTpl = modal.querySelector('[data-spadra-specialist]');
    var SPECIALIST = modal.getAttribute('data-specialist-name') || 'your specialist';

    var MAX_RESULTS = 4;
    var GOAL_Q = 1; // index of the main-focus question, which drives one pick each

    // The multi-pack tiers, and the list of products they actually apply to,
    // now live in snippets/spadra-stack-discounts.liquid — shared with the PDP
    // stack picker so the two can never drift apart. A pack that is not on
    // that list must never be shown a percentage it will not receive; that is
    // the same failure mode as the catalogue-truncation bug fixed earlier in
    // this project.
    var STACK_DISCOUNT_HANDLES = {};
    var STACK_TIERS = [];
    try {
      var discEl = modal.querySelector('[data-spadra-stack-discounts]');
      var disc = discEl ? JSON.parse(discEl.textContent) : null;
      if (disc) {
        (disc.eligible || []).forEach(function (h) { STACK_DISCOUNT_HANDLES[h] = true; });
        STACK_TIERS = (disc.tiers || []).slice();
      }
    } catch (e) { /* no tiers: the set card simply shows no discount claim */ }

    // Real capsule photography, keyed by lowercased ingredient name. Same map
    // the product cards and the PDP use.
    var ING_IMAGES = {};
    try {
      var ingEl = modal.querySelector('[data-spadra-ingredient-images]');
      if (ingEl) ING_IMAGES = JSON.parse(ingEl.textContent) || {};
    } catch (e) { /* cards just render without capsule shots */ }

    // A pack listed in two category collections arrives twice; keep the first.
    var CATALOG = [];
    try {
      var raw = JSON.parse(catalogEl.textContent) || [];
      var byHandle = {};
      raw.forEach(function (p) {
        if (p && p.handle && !byHandle[p.handle]) {
          byHandle[p.handle] = true;
          CATALOG.push(p);
        }
      });
    } catch (e) { CATALOG = []; }

    // ---- Questions -------------------------------------------------------
    // `multi: true` lets an answer set be chosen. Each answer carries `w`:
    // handle -> score, optionally `g`: group -> score, and `label`: the short
    // name echoed back on the matching result card.
    var QUESTIONS = [
      {
        q: 'Who are we building this protocol for?',
        a: [
          { t: 'A man', audience: 'men' },
          { t: 'A woman', audience: 'women' },
          { t: 'Prefer not to say', audience: null }
        ]
      },
      {
        q: "What's your main health focus right now?",
        hint: 'Choose as many as apply — you’ll get a protocol for each.',
        multi: true,
        a: [
          {
            t: 'I want more energy and stamina for my daily life.',
            label: 'Energy and stamina',
            w: { 'energy-pack-spadra': 10, 'performance-pack-1': 9, 'muscle-preserve-pack-spadra': 7, 'adrenal-pack-spadra': 6, 'mineral-pack-spadra': 4 }
          },
          {
            t: "I socialize often and can't afford the next-day cost.",
            label: 'Social recovery and next-day output',
            w: { 'party-pack-1': 10, 'party-recovery-spadra': 10, 'party-hangover-recovery-pack': 9, 'liver-detox-pack-spadra': 8, 'toxin-detox-pack-1': 5 }
          },
          {
            t: 'I need better focus, memory, and mental clarity.',
            label: 'Focus and clarity',
            w: { 'focus-pack-spadra': 10, 'brain-pack-1': 9, 'nerve-support-pack-spadra': 6, 'psychedelic-neuro-integration-pack': 4, 'methylation-pack-spadra': 4 },
            g: { 'focus-brain': 2 }
          },
          {
            t: 'I want to sleep deeper and recover from stress faster.',
            label: 'Sleep and stress recovery',
            w: { 'sleep-pack-1': 10, 'sleep-pack-melatonin-spadra': 9, 'stress-pack-spadra': 8, 'adrenal-pack-spadra': 7, 'mood-support-pack-spadra': 5 }
          },
          {
            t: "I'm focused on healthy aging, skin, and hair vitality.",
            label: 'Healthy aging, skin and hair',
            w: { 'longevity-nad-repair-pack': 10, 'beauty-hair-density-pack': 9, 'hair-pack-spadra': 9, 'clear-skin-cellular-radiance-pack': 7, 'antioxidant-pack-spadra': 6 },
            g: { 'longevity-beauty': 2 }
          },
          {
            t: 'I want to optimize my physical performance and blood flow.',
            label: 'Performance and circulation',
            w: { 'nitric-oxide-men-1': 10, 'nitric-oxide-women-spadra': 10, 'performance-pack-1': 8, 'heart-health-spadra': 6, 'blood-pressure-pack-spadra': 5 }
          },
          {
            t: "I'm looking for a strong foundation for overall wellness.",
            label: 'Everyday foundation',
            w: { 'mens-wellness-1': 9, 'womens-wellness-1': 9, 'vegan-nutrient-pack-spadra': 8, 'mineral-pack-spadra': 7, 'immune-pack-spadra': 6, 'antioxidant-pack-spadra': 6 }
          }
        ]
      },
      {
        q: "What's your biggest daily challenge?",
        hint: 'Choose as many as apply.',
        multi: true,
        a: [
          {
            t: 'Mental stress and feeling overwhelmed.',
            w: { 'stress-pack-spadra': 6, 'adrenal-pack-spadra': 5, 'mood-support-pack-spadra': 4, 'sleep-pack-1': 3 }
          },
          {
            t: 'Physical fatigue or intense workouts.',
            w: { 'performance-pack-1': 6, 'muscle-preserve-pack-spadra': 5, 'energy-pack-spadra': 4, 'joint-health-pack-spadra': 3 }
          },
          {
            t: 'Dietary restrictions or poor eating habits.',
            w: { 'vegan-nutrient-pack-spadra': 6, 'mineral-pack-spadra': 5, 'gut-pack-spadra': 4, 'microbiome-pack-spadra': 3 }
          },
          {
            t: 'Hormonal changes or imbalances.',
            w: { 'womens-hormone-pack-1': 6, 'mens-hormone-pack-1': 6, 'perimenopause-pack-spadra': 4, 'thyroid-pack-spadra': 4, 'pms-pack-spadra': 3 }
          },
          {
            t: 'Low motivation or drive.',
            w: { 'mens-hormone-pack-1': 5, 'focus-pack-spadra': 5, 'energy-pack-spadra': 4, 'mood-support-pack-spadra': 4 }
          }
        ]
      },
      {
        q: 'What would make the biggest difference in your day?',
        hint: 'Choose as many as apply.',
        multi: true,
        a: [
          {
            t: 'Waking up refreshed and sharp.',
            w: { 'sleep-pack-1': 6, 'sleep-pack-melatonin-spadra': 5, 'brain-pack-1': 3, 'stress-pack-spadra': 3 }
          },
          {
            t: 'Sustaining energy without the afternoon crash.',
            w: { 'energy-pack-spadra': 6, 'blood-sugar-pack-spadra': 5, 'focus-pack-spadra': 3, 'methylation-pack-spadra': 3 }
          },
          {
            t: 'Feeling confident and vital in my body.',
            w: { 'nitric-oxide-men-1': 5, 'nitric-oxide-women-spadra': 5, 'mens-hormone-pack-1': 4, 'womens-hormone-pack-1': 4 }
          },
          {
            t: 'Having glowing skin and healthy hair.',
            w: { 'hair-pack-spadra': 6, 'beauty-hair-density-pack': 6, 'clear-skin-cellular-radiance-pack': 5, 'antioxidant-pack-spadra': 3 }
          },
          {
            t: 'Recovering quickly from workouts or long days.',
            w: { 'performance-pack-1': 6, 'muscle-preserve-pack-spadra': 5, 'pain-inflammation-spadra': 4, 'joint-health-pack-spadra': 3 }
          }
        ]
      },
      {
        q: "What's your supplement style?",
        a: [
          { t: 'Keep it simple — just one or two essentials.', style: 'simple' },
          { t: 'I want a comprehensive daily protocol.', style: 'comprehensive' },
          { t: "I'm open to suggestions.", style: 'open' }
        ]
      }
    ];

    // The goal question outweighs the refinement questions. The opening
    // who-is-this-for question scores nothing; it filters instead.
    var QUESTION_WEIGHT = [0, 2, 1, 1, 1];
    var STYLE_WEIGHT = 1.5;

    // answers[i] is always an array of selected option indexes, single-select
    // questions included, so scoring and back-navigation take one code path.
    var answers = [];
    var step = 0;

    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (ch) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch];
      });
    }

    function selected(qi) {
      return Array.isArray(answers[qi]) ? answers[qi] : [];
    }

    function chosenAudience() {
      var sel = selected(0);
      if (!sel.length) return null;
      var opt = QUESTIONS[0].a[sel[0]];
      return opt ? opt.audience : null;
    }

    // A pack tagged for one audience is never shown to the other. Untagged
    // packs suit everyone, and "prefer not to say" excludes nothing.
    function eligible() {
      var aud = chosenAudience();
      if (!aud) return CATALOG.slice();
      return CATALOG.filter(function (p) { return !p.audience || p.audience === aud; });
    }

    function scoreTotals(pool) {
      var totals = {};
      var styleChoice = 'open';

      pool.forEach(function (p) { totals[p.handle] = 0; });

      answers.forEach(function (sel, qi) {
        if (!Array.isArray(sel) || !sel.length) return;
        // Divide the question's weight across the chosen answers so that
        // selecting more options widens the field instead of amplifying it.
        var mult = (QUESTION_WEIGHT[qi] || 1) / sel.length;

        sel.forEach(function (ai) {
          var opt = QUESTIONS[qi].a[ai];
          if (!opt) return;
          if (opt.style) styleChoice = opt.style;
          if (opt.w) {
            Object.keys(opt.w).forEach(function (h) {
              if (h in totals) totals[h] += opt.w[h] * mult;
            });
          }
          if (opt.g) {
            pool.forEach(function (p) {
              if (p.group && opt.g[p.group]) totals[p.handle] += opt.g[p.group] * mult;
            });
          }
        });
      });

      // The style question tilts toward narrower or broader formulas without
      // overriding goal fit.
      pool.forEach(function (p) {
        var n = p.size || 0;
        if (!n) return;
        if (styleChoice === 'simple') totals[p.handle] += Math.max(0, 8 - n) * STYLE_WEIGHT;
        else if (styleChoice === 'comprehensive') totals[p.handle] += n * STYLE_WEIGHT;
      });

      return totals;
    }

    function rankedList(pool, totals) {
      return pool
        .filter(function (p) { return totals[p.handle] > 0; })
        .sort(function (a, b) {
          var d = totals[b.handle] - totals[a.handle];
          return d !== 0 ? d : a.title.localeCompare(b.title);
        });
    }

    // One protocol per stated goal first, then the ranking fills any gap.
    function choosePicks() {
      var pool = eligible();
      var totals = scoreTotals(pool);
      var ranked = rankedList(pool, totals);
      var picks = [];
      var seen = {};

      selected(GOAL_Q).forEach(function (ai) {
        if (picks.length >= MAX_RESULTS) return;
        var opt = QUESTIONS[GOAL_Q].a[ai];
        if (!opt || !opt.w) return;
        for (var i = 0; i < ranked.length; i++) {
          var p = ranked[i];
          if (seen[p.handle]) continue;
          if (!opt.w[p.handle]) continue;
          seen[p.handle] = true;
          picks.push({ p: p, reason: opt.label || '' });
          break;
        }
      });

      ranked.forEach(function (p) {
        if (picks.length >= MAX_RESULTS || seen[p.handle]) return;
        seen[p.handle] = true;
        picks.push({ p: p, reason: '' });
      });

      return picks;
    }

    // ---- "How these fit together" ---------------------------------------
    // Derived from the packs' actual actives so it cannot drift from the
    // catalogue, and says plainly when two picks overlap enough that one is
    // the better starting point.
    function overlapOf(a, b) {
      var listA = Array.isArray(a.components) ? a.components : [];
      var listB = Array.isArray(b.components) ? b.components : [];
      var inB = {};
      listB.forEach(function (x) { inB[String(x).toLowerCase()] = true; });
      return listA.filter(function (x) { return inB[String(x).toLowerCase()]; });
    }

    // Conjunction join. Only safe for ingredient names and pack titles, which
    // do not themselves contain "and" — see goalPhrase() below for why goals
    // use a different one.
    function joinList(items) {
      if (items.length === 1) return String(items[0]);
      if (items.length === 2) return items[0] + ' and ' + items[1];
      return items.slice(0, -1).join(', ') + ' and ' + items[items.length - 1];
    }

    function timingNote(a, b) {
      var am = /-am(-|$)/.test(a.handle) || /-am(-|$)/.test(b.handle);
      var pm = /-pm(-|$)/.test(a.handle) || /-pm(-|$)/.test(b.handle);
      if (am && pm) {
        return ' One is a morning pouch and one is an evening pouch, so they are meant to sit at opposite ends of the day.';
      }
      return '';
    }

    function stackNote(picks) {
      if (picks.length < 2) return '';
      var a = picks[0].p;
      var b = picks[1].p;
      var shared = overlapOf(a, b);
      var lead = esc(a.title) + ' and ' + esc(b.title) + ' ';
      var note;

      if (!shared.length) {
        note = lead + 'have no actives in common, so running both widens what you are covering rather than doubling any single dose.';
      } else if (shared.length <= 2) {
        note = lead + 'overlap only on ' + esc(joinList(shared)) +
          '. That is a small enough overlap to take together — worth mentioning to your provider if you are sensitive to ' +
          (shared.length === 1 ? 'it' : 'either') + '.';
      } else {
        note = lead + 'share ' + shared.length + ' actives, including ' + esc(joinList(shared.slice(0, 3))) +
          '. Taking both would double those doses, so most people are better off starting with one and adding the second later if they still want it.';
      }

      return note + timingNote(a, b);
    }

    // ---- Complete the set --------------------------------------------
    // Shown when 2+ buyable picks come back. Price math is computed here from
    // the catalogue's own price_cents, not typed in — it can only ever be
    // right or absent, never stale. The percentage comes from the real tier
    // table and is counted only over the packs that are actually on the
    // discount's eligible list; if that count reaches no tier, the card shows
    // no price claim at all rather than a vague one.
    function money(cents) {
      return '$' + (Math.round(cents) / 100).toFixed(2);
    }

    // The rate that n eligible packs actually earn, from the real tier table.
    function rateFor(n) {
      var best = 0;
      STACK_TIERS.forEach(function (t) { if (n >= t.qty && t.percent > best) best = t.percent; });
      return best;
    }

    function completeSetHTML(packs) {
      if (packs.length < 2) return '';
      var eligible = packs.filter(function (p) { return STACK_DISCOUNT_HANDLES[p.handle]; });
      var rate = rateFor(eligible.length);
      var subtotal = packs.reduce(function (sum, p) { return sum + (p.price_cents || 0); }, 0);
      var names = packs.map(function (p) { return p.title; });

      // Only claim a discount the cart will really give. The tier comes off the
      // eligible packs alone, so anything else in the set stays at full price
      // in this maths. No qualifying tier means no price claim at all.
      var priceLine = '';
      if (rate > 0 && subtotal) {
        var eligCents = eligible.reduce(function (s, p) { return s + (p.price_cents || 0); }, 0);
        var now = Math.round(eligCents * (100 - rate) / 100) + (subtotal - eligCents);
        priceLine = '<p class="spadra-quiz__set-price">' +
          '<span class="spadra-quiz__set-was">' + esc(money(subtotal)) + '</span> ' +
          '<span class="spadra-quiz__set-now">' + esc(money(now)) + '</span>' +
          '<span class="spadra-quiz__set-badge">' + rate + '% off</span>' +
          '</p><p class="spadra-quiz__set-note">Applied automatically at checkout.</p>';
      }

      return '<div class="spadra-quiz__complete-set">' +
        '<p class="spadra-quiz__complete-set-title">Complete the set</p>' +
        '<p class="spadra-quiz__complete-set-body">All ' + packs.length + ' as one order — ' + esc(joinList(names)) + '.</p>' +
        priceLine +
        '</div>';
    }

    // Real capsule photography for a pack's actives. Ingredients with no
    // confirmed photo are simply left out rather than rendering a guessed path.
    function ingredientRow(p) {
      var comps = Array.isArray(p.components) ? p.components : [];
      if (!comps.length) return '';
      var shots = comps.map(function (c) {
        var src = ING_IMAGES[String(c).toLowerCase().replace(/^\s+|\s+$/g, '')];
        if (!src) return '';
        return '<span class="spadra-quiz-card__ing">' +
          '<img src="' + esc(src) + '?width=120" alt="' + esc(c) + ' capsule" loading="lazy" decoding="async">' +
          '</span>';
      }).filter(Boolean);
      if (!shots.length) return '';
      return '<span class="spadra-quiz-card__ings">' + shots.join('') +
        '<span class="spadra-quiz-card__ings-n">' + comps.length + ' actives</span></span>';
    }

    // ---- Specialist match ------------------------------------------------
    // Cloned from the Liquid <template> so the copy stays editable, with the
    // shopper's own goals and matched pack substituted in.
    //
    // Goal labels already contain "and" ("Energy and stamina", "Focus and
    // clarity"), so joining them with another "and" reads as
    // "energy and stamina and focus and clarity". Multiple goals are therefore
    // listed comma-separated between em dashes, and counted, rather than run
    // through joinList().
    function goalPhrase() {
      var labels = selected(GOAL_Q).map(function (i) {
        var o = QUESTIONS[GOAL_Q].a[i];
        return o && o.label ? o.label.toLowerCase() : '';
      }).filter(Boolean);

      if (!labels.length) {
        return SPECIALIST + ' picks your protocol up from here and works it with you week by week.';
      }
      if (labels.length === 1) {
        return 'You told us your focus is ' + labels[0] + '. That is the ground ' + SPECIALIST + ' works on most.';
      }
      return 'You told us about ' + labels.length + ' priorities — ' + labels.join(', ') +
        ' — all areas ' + SPECIALIST + ' works on directly.';
    }

    function specialistHTML(picks) {
      if (!specialistTpl || !picks.length) return '';
      return specialistTpl.innerHTML
        .replace(/\{\{GOAL_PHRASE\}\}/g, esc(goalPhrase()))
        .replace(/\{\{PACK_NAME\}\}/g, esc(picks[0].p.title));
    }

    // ---- Rendering -------------------------------------------------------
    function setProgress() {
      var pct = Math.round((step / QUESTIONS.length) * 100);
      if (progressFill) progressFill.style.width = pct + '%';
      if (progressText) progressText.textContent = 'Question ' + Math.min(step + 1, QUESTIONS.length) + ' of ' + QUESTIONS.length;
    }

    function renderQuestion() {
      var q = QUESTIONS[step];
      var sel = selected(step);
      if (heading) heading.textContent = q.q;
      if (progressWrap) progressWrap.hidden = false;
      setProgress();
      if (backBtn) backBtn.hidden = step === 0;

      var html = '';
      if (q.hint) html += '<p class="spadra-quiz__hint">' + esc(q.hint) + '</p>';

      html += '<ul class="spadra-quiz__options' + (q.multi ? ' spadra-quiz__options--multi' : '') + '">';
      html += q.a.map(function (opt, i) {
        var on = sel.indexOf(i) !== -1;
        return '<li><button type="button" class="spadra-quiz__option" data-choice="' + i + '"' +
          ' role="' + (q.multi ? 'checkbox' : 'radio') + '"' +
          ' aria-checked="' + (on ? 'true' : 'false') + '">' +
          (q.multi ? '<span class="spadra-quiz__box" aria-hidden="true"></span>' : '') +
          '<span>' + esc(opt.t) + '</span></button></li>';
      }).join('');
      html += '</ul>';

      if (q.multi) {
        html += '<button type="button" class="spadra-quiz__next" data-quiz-next' +
          (sel.length ? '' : ' disabled') + '>' +
          (sel.length > 1 ? 'Continue with ' + sel.length + ' selected' : 'Continue') +
          '</button>';
      }

      body.innerHTML = html;
    }

    function card(pick, badge) {
      var p = pick.p;
      var img = p.image
        ? '<span class="spadra-quiz-card__media"><img src="' + esc(p.image) + '" alt="" loading="lazy"></span>'
        : '<span class="spadra-quiz-card__media"><span class="spadra-quiz-card__ph"></span></span>';
      return '<a class="spadra-quiz-card" href="' + esc(p.url) + '">' + img +
        '<span class="spadra-quiz-card__text">' +
        (badge ? '<span class="spadra-quiz-card__badge">' + esc(badge) + '</span>' : '') +
        '<span class="spadra-quiz-card__title">' + esc(p.title) + '</span>' +
        (pick.reason ? '<span class="spadra-quiz-card__reason">For: ' + esc(pick.reason) + '</span>' : '') +
        (p.subtitle ? '<span class="spadra-quiz-card__sub">' + esc(p.subtitle) + '</span>' : '') +
        ingredientRow(p) +
        '<span class="spadra-quiz-card__price">' + esc(p.price) + ' &middot; 30-day supply</span>' +
        '</span></a>';
    }

    function renderResults() {
      var picks = choosePicks();
      if (progressWrap) progressWrap.hidden = true;
      if (backBtn) backBtn.hidden = false;

      if (!picks.length) {
        if (heading) heading.textContent = 'Browse the full protocol range';
        body.innerHTML = '<p class="spadra-quiz__empty">We could not narrow this down automatically. ' +
          '<a href="/collections/all">Browse every protocol</a> or start the assessment again.</p>' +
          '<button type="button" class="spadra-quiz__restart" data-quiz-restart>Start over</button>';
        return;
      }

      try {
        window.sessionStorage.setItem(
          'spadraQuizMatches',
          JSON.stringify(picks.map(function (x) { return x.p.handle; }))
        );
      } catch (e) { /* private browsing — results still render */ }

      var goalCount = selected(GOAL_Q).length;
      if (heading) {
        heading.textContent = picks.length > 1
          ? 'Your ' + picks.length + ' protocols'
          : 'Your protocol match';
      }

      var html = '<div class="spadra-quiz__results">';

      // Only claim one-per-goal when there really is one per goal. If the
      // catalogue could not supply that many, say what is actually shown.
      if (goalCount > 1 && picks.length >= goalCount) {
        html += '<p class="spadra-quiz__lede">You told us about ' + goalCount +
          ' things. Here is one protocol for each, in the order you chose them.</p>';
      } else if (picks.length > 1) {
        html += '<p class="spadra-quiz__lede">Your closest matches, best fit first.</p>';
      }

      // Human-in-the-loop first, per the owner's explicit ask: the specialist
      // match sits above the protocol cards, and the results follow naturally
      // underneath it rather than the other way around.
      html += specialistHTML(picks);

      html += '<div class="spadra-quiz__primary">' + card(picks[0], 'Best match') + '</div>';

      if (picks.length > 1) {
        html += '<div class="spadra-quiz__also">' +
          picks.slice(1).map(function (x) { return card(x, ''); }).join('') +
          '</div>';

        var note = stackNote(picks);
        if (note) {
          html += '<div class="spadra-quiz__stack">' +
            '<p class="spadra-quiz__stack-title">How these fit together</p>' +
            '<p class="spadra-quiz__stack-body">' + note + '</p>' +
            '</div>';
        }
      }

      var buyable = picks
        .map(function (x) { return x.p; })
        .filter(function (p) { return p.vid && p.available; });

      if (buyable.length >= 2) {
        html += completeSetHTML(buyable.slice(0, 3));
      }

      html += '<div class="spadra-quiz__actions">';
      if (buyable.length > 1) {
        html += '<button type="button" class="spadra-quiz__bundle" data-quiz-bundle="' +
          esc(buyable.map(function (p) { return p.vid; }).join(',')) + '">Add all ' + buyable.length + ' to cart</button>';
      } else if (buyable.length === 1) {
        html += '<button type="button" class="spadra-quiz__bundle" data-quiz-bundle="' +
          esc(String(buyable[0].vid)) + '">Add to cart</button>';
      }
      html += '<button type="button" class="spadra-quiz__restart" data-quiz-restart>Start over</button>' +
        '<a class="spadra-quiz__browse" href="/collections/all">Browse all protocols</a>' +
        '</div>';
      html += '<p class="spadra-quiz__cart-error" data-quiz-cart-error hidden>' +
        'We could not add that to your cart. Please open the protocol page and try again.</p>';
      html += '</div>';
      body.innerHTML = html;
    }

    function render() {
      if (step < QUESTIONS.length) renderQuestion();
      else renderResults();
    }

    root.addEventListener('click', function (e) {
      var choice = e.target.closest('[data-choice]');
      if (choice) {
        var i = parseInt(choice.getAttribute('data-choice'), 10);
        var q = QUESTIONS[step];
        if (q.multi) {
          var sel = selected(step).slice();
          var at = sel.indexOf(i);
          if (at === -1) sel.push(i);
          else sel.splice(at, 1);
          answers[step] = sel;
          renderQuestion();
        } else {
          answers[step] = [i];
          step += 1;
          render();
        }
        return;
      }
      if (e.target.closest('[data-quiz-next]')) {
        if (!selected(step).length) return;
        step += 1;
        render();
        return;
      }
      if (e.target.closest('[data-quiz-restart]')) {
        answers = [];
        step = 0;
        render();
        return;
      }
      if (e.target.closest('[data-quiz-back]')) {
        if (step > 0) step -= 1;
        render();
        return;
      }
      var bundleBtn = e.target.closest('[data-quiz-bundle]');
      if (bundleBtn) addBundle(bundleBtn);
    });

    function addBundle(btn) {
      var ids = btn.getAttribute('data-quiz-bundle').split(',').filter(Boolean);
      if (!ids.length) return;

      var err = modal.querySelector('[data-quiz-cart-error]');
      if (err) err.hidden = true;
      var label = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Adding…';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          items: ids.map(function (id) { return { id: Number(id), quantity: 1 }; })
        })
      })
        .then(function (r) {
          if (!r.ok) throw new Error('cart');
          return r.json();
        })
        .then(function () { window.location.href = '/cart'; })
        .catch(function () {
          btn.disabled = false;
          btn.textContent = label;
          if (err) err.hidden = false;
        });
    }

    render();
  })();
</script>

