{% endstylesheet %}

{% schema %}
{
  "name": "SPADRA protocol quiz",
  "settings": [
    {
      "type": "header",
      "content": "Specialist match"
    },
    {
      "type": "paragraph",
      "content": "Shown after the assessment, above the buttons. Everything here is a promise a real person has to keep for every customer who sees it — turn the block off rather than letting it overstate what you can deliver."
    },
    { "type": "checkbox", "id": "specialist_enabled", "label": "Show the specialist match block", "default": true },
    { "type": "text", "id": "badge_label", "label": "Badge", "default": "Human-in-the-loop concierge included" },
    { "type": "text", "id": "specialist_name", "label": "Specialist name", "default": "Bobbin" },
    {
      "type": "text",
      "id": "specialist_role",
      "label": "Role title",
      "default": "Support Specialist",
      "info": "Keep this a coaching title. Anything implying clinical qualification needs to be true and provable."
    },
    { "type": "image_picker", "id": "specialist_photo", "label": "Photo", "info": "Optional. Use a real photo of this person or leave it empty." },
    {
      "type": "text",
      "id": "specialist_tags",
      "label": "Areas of focus",
      "default": "biohacking and nitric-oxide optimisation, cognitive performance, and lifestyle accountability"
    },
    {
      "type": "header",
      "content": "What is included"
    },
    { "type": "text", "id": "cadence_label", "label": "Check-in cadence", "default": "Two direct check-ins a week" },
    {
      "type": "textarea",
      "id": "cadence_detail",
      "label": "Check-in detail",
      "default": "No upgrade and no per-session fee. We look at how the protocol is landing and adjust timing or dosage from there."
    },
    {
      "type": "textarea",
      "id": "tracking_detail",
      "label": "Tracking detail",
      "default": "Adjustments are based on what you report back week to week — sleep, energy, training load, appetite, whatever you are actually tracking."
    },
    {
      "type": "textarea",
      "id": "accountability_detail",
      "label": "Accountability detail",
      "default": "A real person, not an autoresponder, making sure the routine stays consistent through the months where consistency is the whole job."
    },
    {
      "type": "header",
      "content": "90-day roadmap"
    },
    { "type": "text", "id": "roadmap_title", "label": "Roadmap title", "default": "Your 90-day roadmap" },
    { "type": "text", "id": "phase_1_title", "label": "Month 1 title", "default": "Baseline and lifestyle integration" },
    {
      "type": "textarea",
      "id": "phase_1_body",
      "label": "Month 1 focus",
      "default": "Learning your actual routine, noting early responses, and settling dosage timing into the day you already have. The goal this month is consistency, not results."
    },
    { "type": "text", "id": "phase_2_title", "label": "Month 2 title", "default": "Optimisation and tracking" },
    {
      "type": "textarea",
      "id": "phase_2_body",
      "label": "Month 2 focus",
      "default": "Reviewing the first 30 days together, adjusting the protocol where the response warrants it, and clearing whatever practical thing is getting in the way."
    },
    { "type": "text", "id": "phase_3_title", "label": "Month 3 title", "default": "Sustained performance and accountability" },
    {
      "type": "textarea",
      "id": "phase_3_body",
      "label": "Month 3 focus",
      "default": "Holding what is working, making the habit self-sustaining, and setting the maintenance plan for where your goals go next."
    },
    {
      "type": "header",
      "content": "Activation and disclaimer"
    },
    {
      "type": "text",
      "id": "activation_line",
      "label": "Activation line",
      "default": "to your cart activates your one-to-one access, starting the day your protocol is delivered.",
      "info": "Follows the pack name. Make sure this describes what actually happens after an order."
    },
    {
      "type": "textarea",
      "id": "specialist_disclaimer",
      "label": "Role disclaimer",
      "default": "Support Specialist is a coaching and accountability role, not a clinical one. Your specialist does not provide medical advice, diagnose conditions, or replace your healthcare provider.",
      "info": "Required on a supplement storefront. Do not remove this."
    }
  ]
}
{% endschema %}
