                when 'Trace Minerals'
                  assign ing_benefit = 'Supports enzymatic mineral cofactor repletion.'
                when 'Calcium Citrate'
                  assign ing_benefit = 'Supports bone mineral matrix supply.'
                when 'Boron'
                  assign ing_benefit = 'Supports SHBG regulation and vitamin D utilization.'
                when 'DHEA'
                  assign ing_benefit = 'Upstream hormone precursor support.'
                when 'DIM'
                  assign ing_benefit = 'Supports estrogen metabolism toward the 2-hydroxy pathway.'
                when 'Fenugreek'
                  assign ing_benefit = 'Hormonal and libido botanical support.'
                when 'Tribulus'
