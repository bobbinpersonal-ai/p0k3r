    {%- endif -%}

    <div class="spadra-pdp__block spadra-pdp__block--protocol">
      <p class="spadra-pdp__eyebrow">Your Protocol Plan</p>
      <h2 class="spadra-pdp__h2">What to expect at 30, 60, and 90 days</h2>
      <p class="spadra-pdp__body spadra-pdp__body--intro">Supplements work on biological timelines, not marketing ones. Here is an honest map of what changes when &mdash; and what to judge at each checkpoint.</p>

      <ol class="spadra-phases">
        <li class="spadra-phase">
          <div class="spadra-phase__marker" aria-hidden="true"><span>1</span></div>
          <div class="spadra-phase__content">
            <p class="spadra-phase__range">Days 1&ndash;30</p>
            <h3 class="spadra-phase__title">Initiation Phase</h3>
            <dl class="spadra-phase__dl">
              <dt>Objective</dt>
              <dd>{{ o1 }}</dd>
              <dt>Expected Experience</dt>
              <dd>{{ e1 }}</dd>
              {%- if proto.d30 != blank -%}
                <dt>Example</dt>
                <dd>{% render 'spadra-us', text: proto.d30 %}</dd>
              {%- endif -%}
            </dl>
          </div>
        </li>
        <li class="spadra-phase">
          <div class="spadra-phase__marker" aria-hidden="true"><span>2</span></div>
          <div class="spadra-phase__content">
            <p class="spadra-phase__range">Days 31&ndash;60</p>
            <h3 class="spadra-phase__title">Consolidation Phase</h3>
            <dl class="spadra-phase__dl">
              <dt>Objective</dt>
              <dd>{{ o2 }}</dd>
              <dt>Expected Experience</dt>
              <dd>{{ e2 }}</dd>
              {%- if proto.d60 != blank -%}
                <dt>Example</dt>
                <dd>{% render 'spadra-us', text: proto.d60 %}</dd>
              {%- endif -%}
            </dl>
          </div>
        </li>
        <li class="spadra-phase">
          <div class="spadra-phase__marker" aria-hidden="true"><span>3</span></div>
          <div class="spadra-phase__content">
            <p class="spadra-phase__range">Days 61&ndash;90</p>
            <h3 class="spadra-phase__title">Refinement Phase</h3>
            <dl class="spadra-phase__dl">
              <dt>Objective</dt>
              <dd>{{ o3 }}</dd>
              <dt>Expected Experience</dt>
              <dd>{{ e3 }}</dd>
              {%- if proto.d90 != blank -%}
                <dt>Example</dt>
                <dd>{% render 'spadra-us', text: proto.d90 %}</dd>
              {%- endif -%}
            </dl>
          </div>
        </li>
      </ol>
    </div>

    {%- if related and related.size > 0 -%}
      <div class="spadra-pdp__block spadra-pdp__block--related">
        <p class="spadra-pdp__eyebrow" data-spadra-rel-eyebrow>You May Also Like</p>
        <h2 class="spadra-pdp__h2" data-spadra-rel-heading>Protocols that pair well with this one</h2>
        <div class="spadra-rel-grid" data-spadra-rel-grid>
          {%- for h in related -%}
            {%- assign rp = all_products[h] -%}
            {%- if rp != empty and rp.handle != product.handle -%}
              <a class="spadra-rel-card" href="{{ rp.url }}">
                <span class="spadra-rel-card__media">
                  {%- if rp.featured_image -%}
                    {{ rp.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: rp.title, class: 'spadra-rel-card__img' }}
                  {%- else -%}
                    <span class="spadra-rel-card__placeholder"></span>
                  {%- endif -%}
                </span>
                <span class="spadra-rel-card__label">{{ rp.metafields.spadra.category_label.value }}</span>
                <span class="spadra-rel-card__title">{{ rp.title }}</span>
                <span class="spadra-rel-card__price">{{ rp.price | money }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <div class="spadra-pdp__block spadra-pdp__block--legal">
      <h2 class="spadra-legal__h">Important information</h2>
      <p class="spadra-legal__p">These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</p>
      <p class="spadra-legal__p">SPADRA supplement packs are not a substitute for prescription medication and should be used with your healthcare provider.</p>
      {%- if filt == 'glp1-care' -%}
        <p class="spadra-legal__p">Ozempic&reg;, Wegovy&reg; and Mounjaro&reg; are registered trademarks of their respective manufacturers. SPADRA is not affiliated with, endorsed by, or sponsored by any of these manufacturers.</p>
      {%- endif -%}
    </div>

  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('[data-spadra-pdp]');
    if (!root) return;
    var grid = root.querySelector('[data-spadra-rel-grid]');
    if (!grid) return;

    var raw;
    try { raw = window.sessionStorage.getItem('spadraQuizMatches'); } catch (e) { return; }
    if (!raw) return;

    var handles;
    try { handles = JSON.parse(raw); } catch (e) { return; }
    if (!Array.isArray(handles) || !handles.length) return;

    var self = root.getAttribute('data-handle');
    handles = handles.filter(function (h) { return h && h !== self; }).slice(0, 4);
    if (!handles.length) return;

    var money = function (cents) {
      return '$' + (cents / 100).toFixed(2);
    };

    Promise.all(handles.map(function (h) {
      return fetch('/products/' + h + '.js')
        .then(function (r) { return r.ok ? r.json() : null; })
        .catch(function () { return null; });
    })).then(function (items) {
      items = items.filter(Boolean);
      if (!items.length) return;

      grid.innerHTML = items.map(function (p) {
        var img = p.featured_image
          ? '<span class="spadra-rel-card__media"><img class="spadra-rel-card__img" loading="lazy" alt="" src="' + p.featured_image + '"></span>'
          : '<span class="spadra-rel-card__media"><span class="spadra-rel-card__placeholder"></span></span>';
        return '<a class="spadra-rel-card" href="/products/' + p.handle + '">' + img +
          '<span class="spadra-rel-card__label">Matched to your quiz</span>' +
          '<span class="spadra-rel-card__title">' + p.title + '</span>' +
          '<span class="spadra-rel-card__price">' + money(p.price) + '</span></a>';
      }).join('');

      var eyebrow = root.querySelector('[data-spadra-rel-eyebrow]');
      var heading = root.querySelector('[data-spadra-rel-heading]');
      if (eyebrow) eyebrow.textContent = 'Based On Your Quiz';
      if (heading) heading.textContent = 'Recommended for your protocol';
    });
  })();
</script>

{% stylesheet %}
  .spadra-pdp {
    background: #FFFFFF;
    color: #1A1A1A;
    padding: 8px 20px 64px;
  }
  .spadra-pdp__inner {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .spadra-pdp__block { scroll-margin-top: 80px; }
  .spadra-pdp__eyebrow {
    margin: 0 0 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #00A344;
  }
  .spadra-pdp__h2 {
    margin: 0 0 16px;
    font-size: 1.6rem;
    line-height: 1.25;
    color: #000000;
    text-wrap: pretty;
  }
  .spadra-pdp__lede,
  .spadra-pdp__body {
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
    color: #33383F;
    text-wrap: pretty;
  }
  .spadra-pdp__body--intro { margin-bottom: 28px; }
  .spadra-pdp__callout {
    margin: 0 0 16px;
    padding: 16px 18px;
    border-left: 3px solid #00C853;
    background: #F4FBF6;
    border-radius: 0 10px 10px 0;
    font-size: 1rem;
    line-height: 1.6;
    color: #1A1A1A;
  }

  /* --- What's Inside --- */
  .spadra-ing-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .spadra-ing {
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 14px 16px;
    background: #FCFCFB;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .spadra-ing__name {
    font-weight: 700;
    font-size: 0.95rem;
    color: #000000;
  }
  .spadra-ing__benefit {
    font-size: 0.85rem;
    line-height: 1.5;
    color: #5B6470;
  }

  /* --- 30-60-90 --- */
  .spadra-phases {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .spadra-phase {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 18px;
    position: relative;
    padding-bottom: 32px;
  }
  .spadra-phase:last-child { padding-bottom: 0; }
  .spadra-phase::before {
    content: '';
    position: absolute;
    left: 21px;
    top: 44px;
    bottom: 0;
    width: 2px;
    background: #E2E8F0;
  }
  .spadra-phase:last-child::before { display: none; }
  .spadra-phase__marker {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #000000;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
    position: relative;
    z-index: 1;
  }
  .spadra-phase__range {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6B7280;
  }
  .spadra-phase__title {
    margin: 2px 0 12px;
    font-size: 1.15rem;
    color: #000000;
  }
  .spadra-phase__dl { margin: 0; }
  .spadra-phase__dl dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: #00A344;
    margin-top: 12px;
  }
  .spadra-phase__dl dt:first-child { margin-top: 0; }
  .spadra-phase__dl dd {
    margin: 4px 0 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: #33383F;
    text-wrap: pretty;
  }

  /* --- You May Also Like --- */
  .spadra-rel-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .spadra-rel-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    color: inherit;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    overflow: hidden;
    padding-bottom: 12px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .spadra-rel-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }
  .spadra-rel-card__media {
    display: block;
    aspect-ratio: 4 / 5;
    background: #F8F7F4;
  }
  .spadra-rel-card__img,
  .spadra-rel-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .spadra-rel-card__label {
    margin-top: 10px;
    padding: 0 12px;
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #6B7280;
  }
  .spadra-rel-card__title {
    padding: 0 12px;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.35;
    color: #000000;
  }
  .spadra-rel-card__price {
    padding: 0 12px;
    font-size: 0.85rem;
    color: #33383F;
  }

  /* --- Legal --- */
  .spadra-pdp__block--legal {
    border-top: 1px solid #E2E8F0;
    padding-top: 28px;
  }
  .spadra-legal__h {
    margin: 0 0 12px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6B7280;
  }
  .spadra-legal__p {
    margin: 0 0 10px;
    font-size: 0.78rem;
    line-height: 1.6;
    color: #6B7280;
  }
  .spadra-legal__p:last-child { margin-bottom: 0; }

  /* --- Mobile --- */
  @media screen and (max-width: 749px) {
    .spadra-pdp { padding: 8px 16px 48px; }
    .spadra-pdp__inner { gap: 44px; }
    .spadra-pdp__h2 { font-size: 1.35rem; }
    .spadra-ing-list { grid-template-columns: 1fr; }
    .spadra-rel-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .spadra-phase { grid-template-columns: 36px 1fr; gap: 14px; }
    .spadra-phase__marker { width: 36px; height: 36px; font-size: 0.9rem; }
    .spadra-phase::before { left: 17px; top: 36px; }
  }
{% endstylesheet %}

