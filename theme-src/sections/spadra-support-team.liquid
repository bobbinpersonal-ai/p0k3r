{%- comment -%}
  "Meet Your Support Team" — trust + sales-support hub, sits under the protocol grid.

  Team members are blocks, so real people get added as they actually join. Each
  block needs a name and a role; a block with no name is skipped rather than
  rendering an anonymous placeholder card.

  The availability line and CTA are settings, not hardcoded copy — say only what
  you can actually staff.
{%- endcomment -%}

<section class="spadra-team" style="background: {{ section.settings.background_color }};">
  <div class="spadra-team__inner">
    <div class="spadra-team__copy">
      <p class="spadra-team__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="spadra-team__title">{{ section.settings.title }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="spadra-team__body">{{ section.settings.body }}</p>
      {%- endif -%}

      <div class="spadra-team__actions">
        <a
          class="spadra-team__cta"
          href="{{ section.settings.cta_link | default: '/pages/contact' }}"
          data-spadra-chat-cta
        >{{ section.settings.cta_label }}</a>
        <button type="button" class="spadra-team__quiz-cta" data-spadra-quiz-open>
          {{ section.settings.secondary_label }}
        </button>
      </div>

      {%- if section.settings.availability != blank -%}
        <p class="spadra-team__availability">{{ section.settings.availability }}</p>
      {%- endif -%}
    </div>

    <ul class="spadra-team__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'member' and block.settings.name != blank -%}
          <li class="spadra-team-card" {{ block.shopify_attributes }}>
            <div class="spadra-team-card__media">
              {%- if block.settings.photo != blank -%}
                {{
                  block.settings.photo
                  | image_url: width: 320
                  | image_tag: loading: 'lazy', alt: block.settings.name, class: 'spadra-team-card__img'
                }}
              {%- else -%}
                <span class="spadra-team-card__initials" aria-hidden="true">
                  {{ block.settings.name | split: ' ' | first | slice: 0 }}
                </span>
              {%- endif -%}
            </div>
            <p class="spadra-team-card__name">{{ block.settings.name }}</p>
            {%- if block.settings.role != blank -%}
              <p class="spadra-team-card__role">{{ block.settings.role }}</p>
            {%- endif -%}
            {%- if block.settings.blurb != blank -%}
              <p class="spadra-team-card__blurb">{{ block.settings.blurb }}</p>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>

  {%- if section.settings.disclaimer != blank -%}
    <p class="spadra-team__legal">{{ section.settings.disclaimer }}</p>
  {%- endif -%}
</section>

<script>
  (function () {
    // If a chat widget is installed, the CTA opens it in place. With no widget
    // present the link is followed normally, so the button is never a dead end.
    var cta = document.querySelector('[data-spadra-chat-cta]');
    if (!cta) return;

    cta.addEventListener('click', function (e) {
      var opened = false;
      try {
        if (window.ShopifyChat && typeof window.ShopifyChat.open === 'function') {
          window.ShopifyChat.open();
          opened = true;
        } else if (window.tidioChatApi && typeof window.tidioChatApi.open === 'function') {
          window.tidioChatApi.open();
          opened = true;
        } else if (window.GorgiasChat && typeof window.GorgiasChat.open === 'function') {
          window.GorgiasChat.open();
          opened = true;
        }
      } catch (err) {
        opened = false;
      }
      if (opened) e.preventDefault();
    });
  })();
</script>

{% stylesheet %}
  .spadra-team { padding: 64px 24px; }
  .spadra-team__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 48px;
    align-items: center;
  }
  .spadra-team__eyebrow {
    margin: 0 0 8px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #00A344;
  }
  .spadra-team__title {
    margin: 0 0 14px;
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    line-height: 1.2;
    color: #000000;
    text-wrap: pretty;
  }
  .spadra-team__body {
    margin: 0 0 22px;
    font-size: 1rem;
    line-height: 1.65;
    color: #33383F;
    text-wrap: pretty;
  }
  .spadra-team__actions { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .spadra-team__cta {
    background: #000000;
    color: #FFFFFF;
    border: none;
    border-radius: 100px;
    padding: 15px 30px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-block;
  }
  .spadra-team__cta:hover { background: #00C853; color: #000000; }
  .spadra-team__quiz-cta {
    background: transparent;
    border: 1px solid #E2E8F0;
    color: #1A1A1A;
    border-radius: 100px;
    padding: 14px 26px;
    font-size: 0.9rem;
    cursor: pointer;
  }
  .spadra-team__quiz-cta:hover { border-color: #00C853; color: #00A544; }
  .spadra-team__availability {
    margin: 14px 0 0;
    font-size: 0.82rem;
    color: #6B7280;
  }

  .spadra-team__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .spadra-team-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 18px 16px 20px;
    text-align: center;
  }
  .spadra-team-card__media {
    width: 96px;
    height: 96px;
    margin: 0 auto 12px;
    border-radius: 50%;
    overflow: hidden;
    background: #F1F5F9;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .spadra-team-card__img { width: 100%; height: 100%; object-fit: cover; }
  .spadra-team-card__initials {
    font-size: 1.9rem;
    font-weight: 700;
    color: #94A3B8;
    text-transform: uppercase;
  }
  .spadra-team-card__name { margin: 0; font-size: 0.98rem; font-weight: 700; color: #000000; }
  .spadra-team-card__role {
    margin: 3px 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #00A344;
  }
  .spadra-team-card__blurb {
    margin: 8px 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: #5B6470;
  }

  .spadra-team__legal {
    max-width: 1100px;
    margin: 28px auto 0;
    font-size: 0.72rem;
    line-height: 1.55;
    color: #6B7280;
  }

  @media screen and (max-width: 989px) {
    .spadra-team__inner { grid-template-columns: 1fr; gap: 32px; }
  }
  @media screen and (max-width: 599px) {
    .spadra-team { padding: 48px 16px; }
    .spadra-team__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .spadra-team__title { font-size: 1.45rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Support Team",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your Support Team" },
    {
      "type": "text",
      "id": "title",
      "label": "Headline",
      "default": "Need help finding your protocol? Talk to a real person."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Intro text",
      "default": "Take the assessment for a personalized match, or message us for one-on-one guidance. We'll help you dial in your stack."
    },
    { "type": "text", "id": "cta_label", "label": "Primary button label", "default": "Message us" },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary button link",
      "info": "Where the button goes if no chat widget is installed. If you install Shopify Inbox, Tidio, or Gorgias, the button opens that chat instead."
    },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Take the 4-question assessment" },
    {
      "type": "text",
      "id": "availability",
      "label": "Availability line",
      "default": "We usually reply within one business day.",
      "info": "State only the response time you can actually keep. Do not promise 24/7 unless someone is genuinely on call around the clock."
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Our team offers product guidance only, not medical advice. Titles describe each person's role at SPADRA and are not clinical credentials. For anything health-related, please speak with your healthcare provider."
    },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team member",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Name", "info": "Use a real person. A block with no name is not rendered." },
        { "type": "text", "id": "role", "label": "Role", "info": "Describe what they actually do here. Avoid clinical titles unless the person holds that credential." },
        { "type": "textarea", "id": "blurb", "label": "Short bio" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Support Team",
      "blocks": [
        { "type": "member", "settings": { "name": "Bobbin", "role": "Founder", "blurb": "Built SPADRA after getting tired of six bottles on the counter. Happy to talk through any protocol." } }
      ]
    }
  ]
}
{% endschema %}
