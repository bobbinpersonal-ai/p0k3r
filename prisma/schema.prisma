generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// status/moveSize are plain strings rather than native Postgres enums so
// adding a new value never needs a migration. Valid values are enforced in
// the API routes (see src/lib/moveSizes.ts and
// the VALID_STATUSES lists in src/app/api/bookings/[id]/route.ts and
// src/app/api/applications/[id]/route.ts).
// Booking status: PENDING | ASSIGNED | IN_PROGRESS | COMPLETED | CANCELED
// MoveSize: FEW_ITEMS | STUDIO | ONE_BED | TWO_BED | THREE_PLUS_BED
// Application status: PENDING | APPROVED | REJECTED
// Applicant role: DRIVER | HELPER (see src/lib/applicantRoles.ts)
// Booking serviceType: SINGLE_ITEM | APARTMENT_HOUSE | STORAGE | OFFICE |
// DONATION | OTHER (see src/lib/serviceTypes.ts)
// payoutMethod: ZELLE | VENMO | APPLE_PAY (see src/lib/payoutMethods.ts)
// Booking serviceLine: LANDSCAPING | MOVING | JUNK (see src/lib/serviceLines.ts)
// Booking yardSize: SMALL | MEDIUM | LARGE | XL, landscapingService:
// MOW_EDGE_BLOW | CLEANUP | TRIM_HAUL | INSTALL, frequency: ONE_TIME | WEEKLY |
// BIWEEKLY | MONTHLY (all three: see src/lib/landscaping.ts)

model Driver {
  id            String    @id @default(cuid())
  name          String
  phone         String
  vehicle       String?
  payoutMethod  String?
  payoutHandle  String?
  active        Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())
  bookings      Booking[]
}

model DriverApplication {
  id           String   @id @default(cuid())
  status       String   @default("PENDING")

  name         String
  phone        String
  email        String?
  city         String?
  role         String?
  vehicle      String?
  payoutMethod String?
  payoutHandle String?
  availability String?
  notes        String?
  source       String?

  // Which recruiting page they came through — LANDSCAPING or MOVING (see
  // src/lib/serviceLines.ts; junk runs on the same trucks and the same people
  // as moving, so it isn't a separate pool to recruit for). Nullable because
  // every applicant before the two pages were split came through one combined
  // page and genuinely didn't say.
  line         String?

  createdAt    DateTime @default(now())
}

// A request to be introduced to licensed contractors — NOT a job we do.
//
// Deliberately its own table rather than a Booking with a flag. A Booking is
// work this company performs and takes money for; one of these is a referral
// out to an independent licensed contractor, with no price, no crew, no
// schedule and no payment. Sharing a table would mean every query about "our
// jobs" had to remember to exclude them, and the first one that forgot would
// put unlicensed work on the dispatch board.
//
// status: NEW | CONTACTED | MATCHED | CLOSED
model ContractorLead {
  id            String   @id @default(cuid())
  status        String   @default("NEW")

  name          String
  phone         String
  email         String?
  zip           String
  projectType   String
  /// The trade's name as it read when they asked, for the same reason
  /// Booking.landscapingServiceLabel exists: the list is editable now.
  projectLabel  String?
  preferredStart String?
  details       String?

  // Which marketing channel sent them, same as everywhere else.
  source        String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Booking {
  id              String    @id @default(cuid())
  status          String    @default("PENDING")

  customerName    String
  customerPhone   String
  customerEmail   String?

  pickupAddress   String
  // Nullable since not every job is a move: a dump run, a donation drop, or
  // help loading a container already in the driveway has one address. See
  // dropoffMode for which kind of job it is.
  dropoffAddress  String?
  dropoffMode     String?   @default("ADDRESS")
  moveDate        DateTime
  timeWindow      String
  city            String?

  // Set when the customer books through the map quote flow. Null for phone
  // bookings and for addresses typed as free text rather than picked from the
  // autocomplete, so dispatch can tell a mapped route from a hand-entered one.
  pickupLat       Float?
  pickupLng       Float?
  dropoffLat      Float?
  dropoffLng      Float?
  distanceMiles   Float?
  vehicleTier     String?

  // Which of the three businesses this job belongs to. It decides which of
  // the fields below mean anything: a yard job has yardSize and no vehicle
  // tier or route, a move has moveSize and a distance. Defaulted rather than
  // nullable so every booking taken before the landscaping pivot reads back
  // as what it was — a move.
  serviceLine     String    @default("MOVING")

  // Moving and junk jobs. Nullable since the landscaping pivot: a lawn has no
  // move size.
  moveSize        String?
  serviceType     String?
  serviceTypeOther String?
  needsHelper     Boolean   @default(true)

  // Landscaping jobs. The price is flat per (service x yard size), so unlike a
  // move there's no range: estimateLow and estimateHigh both hold the per-visit
  // price. frequency is what the customer signed up for — a recurring plan is
  // one Booking row for the first visit, with dispatch repeating it.
  landscapingService String?
  /// The service's name as it read on the day, kept because the catalogue is
  /// editable: renaming a service must not rewrite what a past customer
  /// agreed to on their signed agreement. Null on bookings taken before this
  /// existed, where readers fall back to looking the value up.
  landscapingServiceLabel String?
  yardSize        String?
  frequency       String?

  details         String?
  // Which marketing channel this lead came from, tracked the same way as
  // DriverApplication.source: /book?source=<value>. See src/lib/sources.ts.
  source          String?

  estimateLow     Int
  estimateHigh    Int

  driverId        String?
  driver          Driver?   @relation(fields: [driverId], references: [id])
  dispatchNotes   String?

  // An unguessable link so a customer can cancel or ask to reschedule without
  // an account — see /manage/[token]. Generated with crypto.randomBytes, not
  // Prisma's cuid() default: a cuid is unique but not built to resist
  // guessing, and this one doubles as the only thing standing between a
  // stranger and someone else's booking.
  //
  // The database-side default is a backfill mechanism, not the normal path —
  // every booking the app creates passes an explicit randomBytes token (see
  // src/lib/manageToken.ts). It exists because this column is NOT NULL and
  // UNIQUE, and adding one of those to a table that already has rows is a
  // change Postgres cannot make on its own: there's no single value it could
  // put in every row without breaking the unique index. Prisma's answer was to
  // refuse the push and offer --force-reset, which drops the database — so
  // every deploy after this column was introduced failed, and production sat
  // two days stale on the last schema that didn't need it. gen_random_uuid()
  // is volatile, so Postgres evaluates it per row and each existing booking
  // gets its own token instead.
  manageToken     String    @unique @default(dbgenerated("gen_random_uuid()"))

  // What was collected on the doorstep, if anything.
  //
  // All three are nullable and stay null on every booking taken through the
  // website: only an authenticated request may set them (see the bookings
  // route), because a public payload that could claim "deposit paid" would
  // be a hole worth exactly the deposit. depositMethod is how the money
  // moved — VENMO, APPLE_PAY, CASH — and is never "NONE": nothing collected
  // is recorded as nothing, not as a method.
  depositAmount   Int?
  depositMethod   String?
  depositPaidAt   DateTime?

  // Idempotency guards: both are set the moment their notification actually
  // sends, so a retried request or a re-run cron can't double-text someone.
  reminderSentAt      DateTime?
  reviewRequestSentAt DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// An edit to the service catalogue, made at /admin/services.
///
/// The catalogue lives in code (src/lib/landscaping.ts) and this table layers
/// over it: a row whose `value` matches a shipped service replaces it, and a
/// row with a new value adds one. Deleting a row therefore *reverts* a
/// built-in to its shipped definition rather than removing the service, which
/// is why deactivating is a flag rather than a delete.
///
/// prices and cost are JSON keyed by yard size. They are validated on write
/// (see src/lib/serviceCatalogue.ts) against the same two rules the shipped
/// prices are held to: nothing may reach the CSLB exemption limit, and every
/// size has to clear the crew wage floor /drive advertises.
model ServiceConfig {
  id              String   @id @default(cuid())
  value           String   @unique
  /// PRICED — we do it, at a flat price per property size.
  /// REFERRAL — we don't; it goes to licensed contractors and carries no
  /// price at all. Painting, roofing, anything past the exemption. The two
  /// live in one table because to the person adding a service they are one
  /// decision ("do we do this, or do we pass it on?"), and splitting them
  /// would mean two screens that have to agree about what a service is.
  mode            String   @default("PRICED")
  label           String
  shortLabel      String
  description     String
  includes        String[]
  excludes        String[]
  allowsRecurring Boolean  @default(false)
  materialsNote   String?
  /// Off takes it out of the catalogue everywhere without losing the pricing.
  active          Boolean  @default(true)
  sortOrder       Int      @default(100)
  prices          Json
  cost            Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Texas: in-home residential construction sales ---------------------------
//
// A different business on the same platform. The California side sells small
// jobs online at a flat price; this one sells roofs at a kitchen table, for
// five figures, through 1099 reps working leads the owner hands them.
//
// The shape follows that: a Lead is assigned to a Rep, the Rep runs an
// Appointment at the house and builds an Estimate out of measured lines, and
// what they sell it for above the price book's base is 60% theirs. Crews are
// paid separately as 1099 workers by Zelle or Apple Cash.

/// A 1099 sales rep. Runs appointments on leads assigned to them.
model Rep {
  id            String   @id @default(cuid())
  name          String
  phone         String
  email         String?
  active        Boolean  @default(true)

  /// 1099 paperwork. No W-9, no payout — see WorkerPayout for the same rule
  /// on crews. Kept as a flag rather than the form itself: we need to know
  /// that it exists, not to store a social security number.
  w9OnFile      Boolean  @default(false)

  /// Per-rep commission terms, overriding the company default when set.
  /// Null means "whatever src/lib/texas/commission.ts says today", so a
  /// company-wide change doesn't have to be written to every row.
  baseCommissionRate Float?
  overageRate        Float?

  /// How this rep gets paid. Same two rails as the crews.
  payoutMethod  String?
  payoutHandle  String?

  leads         Lead[]
  estimates     Estimate[]
  appointments  Appointment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Somebody who wants a price. Assigned to a rep by the owner, by hand.
model Lead {
  id            String   @id @default(cuid())
  /// NEW, ASSIGNED, APPOINTMENT_SET, SOLD, NO_SALE, DEAD.
  status        String   @default("NEW")

  customerName  String
  customerPhone String
  customerEmail String?
  address       String
  city          String?
  zip           String?

  /// What they called about, if we know. Null is normal on a cold lead.
  trade         String?
  /// RETAIL (homeowner pays) or INSURANCE (carrier pays, homeowner pays the
  /// deductible). Decides which contract gets generated and which rules apply.
  jobKind       String   @default("RETAIL")

  source        String?
  notes         String?

  repId         String?
  rep           Rep?     @relation(fields: [repId], references: [id])
  assignedAt    DateTime?
  appointmentAt DateTime?

  /// Where this row came from, when it was bought rather than inbound.
  leadListId    String?
  leadList      LeadList? @relation(fields: [leadListId], references: [id])

  /// E.164, and unique across the whole table: the same homeowner turning up
  /// in two purchased lists is one lead with one call history, not two.
  phoneKey      String?   @unique
  /// MOBILE, LANDLINE or UNKNOWN. A bought list's guess, and treated as one.
  lineType      String?
  /// IANA zone for the property, so the curfew is checked where the phone is.
  timeZone      String    @default("America/Chicago")
  /// Copied from the list at scrub time so screening is one query, not two.
  scrubbedAt    DateTime?

  /// TCPA consent, captured when a lead fills in a form themselves.
  ///
  /// Stored as the words they actually saw rather than a boolean, because the
  /// defence to a claim is producing that wording, on that date, at that URL —
  /// and a later edit to the copy must not rewrite what an old lead agreed to.
  /// Null on a purchased lead, which is exactly the point: bought rows carry
  /// no consent, so the calling rules treat them differently.
  consentText   String?
  consentVersion String?
  consentAt     DateTime?
  consentIp     String?
  consentUrl    String?

  attempts      CallAttempt[]
  appointments  Appointment[]

  estimate      Estimate?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([repId])
}

/// What the rep built at the kitchen table, and what the customer signed.
model Estimate {
  id            String   @id @default(cuid())
  /// The customer's unguessable link to their own copy — same reasoning as
  /// Booking.manageToken on the California side.
  token         String   @unique @default(dbgenerated("gen_random_uuid()"))

  leadId        String   @unique
  lead          Lead     @relation(fields: [leadId], references: [id])
  repId         String?
  rep           Rep?     @relation(fields: [repId], references: [id])

  /// DRAFT, PRESENTED, SIGNED, CANCELED.
  status        String   @default("DRAFT")
  jobKind       String   @default("RETAIL")

  /// Insurance jobs only. carrierScope is the carrier's own number for the
  /// work; with the deductible it sets the floor an insurance job may be sold
  /// at, because selling below it absorbs the deductible by arithmetic and
  /// Bus. & Com. Code § 27.02 makes that a crime.
  carrier       String?
  claimNumber   String?
  carrierScope  Int?
  deductible    Int?

  /// The money, all of it stored rather than recomputed: the price book is
  /// editable, and a signed contract must not change when a rate does.
  costTotal     Int
  baseTotal     Int
  soldPrice     Int
  commission    Int

  /// Taken at the table, the same way the California side does it.
  depositAmount Int?
  depositMethod String?
  depositPaidAt DateTime?

  /// Free text the rep types. Screened for deductible language before it is
  /// allowed to reach a contract — see src/lib/texas/compliance.ts.
  scopeNotes    String?

  signedAt      DateTime?
  signerName    String?
  canceledAt    DateTime?
  /// Set when the buyer cancels inside their three business days, so a refund
  /// that is owed can be seen rather than remembered.
  refundDueBy   DateTime?

  lines         EstimateLine[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

/// One measured line of an estimate, frozen at the rates that priced it.
model EstimateLine {
  id            String   @id @default(cuid())
  estimateId    String
  estimate      Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  trade         String
  tradeLabel    String
  option        String
  optionLabel   String
  unit          String
  quantity      Float

  /// The rates as they read on the day, not as they read now.
  costPerUnit   Float
  basePerUnit   Float
  cost          Int
  base          Int

  createdAt     DateTime @default(now())

  @@index([estimateId])
}

/// Somebody on a crew. Paid per job, by Zelle or Apple Cash, on a 1099.
model Worker {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  email         String?
  active        Boolean  @default(true)

  /// The IRS wants a 1099-NEC for anyone paid $600 or more in a calendar
  /// year, and it wants a W-9 on file to fill it in. The flag gates payouts;
  /// the identifier itself is not stored here.
  w9OnFile      Boolean  @default(false)

  /// ZELLE or APPLE_PAY, and the phone or email the money goes to.
  payoutMethod  String?
  payoutHandle  String?

  payouts       WorkerPayout[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// One payment to one worker. The 1099 total is the sum of these by year.
model WorkerPayout {
  id            String   @id @default(cuid())
  workerId      String
  worker        Worker   @relation(fields: [workerId], references: [id])

  amount        Int
  method        String
  /// Where it actually went, copied at the time of paying: a worker who
  /// changes their Zelle number later must not rewrite what we already sent.
  handle        String?
  memo          String?

  /// Which job it was for. Null for a payment that isn't job-specific.
  estimateId    String?

  paidAt        DateTime @default(now())
  /// Denormalised so a year's 1099 totals are one indexed query.
  taxYear       Int

  createdAt     DateTime @default(now())

  @@index([workerId, taxYear])
}

// --- Texas: the calling pipeline ---------------------------------------------
//
// Purchased lists come in as a LeadList, get scrubbed, and feed a queue of
// Leads that setters work by hand. Every dial is recorded as a CallAttempt
// whether it connected or not, because the attempt history is what the
// screening rules in src/lib/texas/calling.ts run on — and because a
// complaint two years from now is answered by records or it is not answered.

/// A batch of leads bought from one broker on one day.
model LeadList {
  id            String   @id @default(cuid())
  name          String
  /// Who sold it to us. Worth keeping: list quality varies enormously and
  /// this is the only way to find out which broker is worth buying from again.
  vendor        String?
  /// What we paid, so cost per booked appointment is computable.
  costCents     Int?

  /// When it was last run against the national and Texas registries. Null
  /// means never, and never means nobody may dial it.
  scrubbedAt    DateTime?
  /// How many rows the scrub removed — a number worth watching, because a
  /// list that loses 40% was sold to you knowing that.
  scrubbedCount Int      @default(0)

  leads         Lead[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// One dial. Logged whether or not anybody picked up.
model CallAttempt {
  id            String   @id @default(cuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Who dialled — a setter or a rep, by name rather than by relation, so the
  /// record survives them leaving.
  calledBy      String
  outcome       String
  notes         String?

  /// The lead's own local time when we rang, stored rather than derived: the
  /// curfew defence is "it was 2pm where they were", and that has to be
  /// answerable years later without re-deriving a time zone.
  localTime     DateTime
  /// Only ever true where consent was captured on the recording itself.
  recorded      Boolean  @default(false)

  createdAt     DateTime @default(now())

  @@index([leadId, createdAt])
}

/// A number that must not be called, and why.
///
/// Separate from Lead on purpose: a do-not-call request attaches to the phone
/// number, not to the row it happened to arrive on. Buy the same number again
/// next year from a different broker and it is still blocked.
model DncEntry {
  id            String   @id @default(cuid())
  /// E.164. The unique key, so re-importing a blocked number cannot un-block it.
  phone         String   @unique
  /// NATIONAL, TEXAS, INTERNAL, LITIGATOR.
  list          String
  /// What they said, where it was a person asking us directly.
  note          String?
  /// Internal requests are honoured forever; registry hits are refreshed.
  addedAt       DateTime @default(now())

  @@index([list])
}

/// A booked in-home consultation. What the whole calling operation is for.
model Appointment {
  id            String   @id @default(cuid())
  leadId        String
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  repId         String?
  rep           Rep?     @relation(fields: [repId], references: [id])

  /// Absolute instant, plus the local wall-clock string the customer was
  /// actually told. Two time zones are involved and only one of them is the
  /// customer's, so the promise is stored as words as well as a timestamp.
  startsAt      DateTime
  localLabel    String

  /// SET, CONFIRMED, SAT, NO_SHOW, CANCELED, RESCHEDULED.
  status        String   @default("SET")
  /// Who set it, for setter scoreboards and for sat-rate by setter.
  setBy         String?
  notes         String?

  confirmedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([repId, startsAt])
  @@index([status])
}

/// A product added or edited at /admin/tx/products.
///
/// Overlays the price book in src/lib/texas/trades.ts the same way
/// ServiceConfig overlays the California catalogue: a row matching a seeded
/// option replaces it, a row with a new value adds one, and deleting a row
/// reverts rather than deletes. Signing a new supplier is a form, not a deploy.
model ProductConfig {
  id            String   @id @default(cuid())
  /// Which trade it belongs to — ROOFING, SIDING, WINDOWS, GUTTERS, FENCE, PAINT.
  trade         String
  value         String

  label         String
  description   String
  brand         String?
  line          String?
  /// GOOD, BETTER or BEST — where it sits in the three a rep lays out.
  tier          String   @default("BETTER")
  /// Copied verbatim from the manufacturer's dealer materials, or null.
  warranty      String?
  sellingPoints String[]

  costPerUnit   Float
  basePerUnit   Float

  active        Boolean  @default(true)
  sortOrder     Int      @default(100)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([trade, value])
  @@index([trade])
}
