generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// status/moveSize are plain strings rather than native Postgres enums so
// adding a new value never needs a migration. Valid values are enforced in
// the API routes (see src/lib/moveSizes.ts and
// the VALID_STATUSES lists in src/app/api/bookings/[id]/route.ts and
// src/app/api/applications/[id]/route.ts).
// Booking status: PENDING | ASSIGNED | IN_PROGRESS | COMPLETED | CANCELED
// MoveSize: FEW_ITEMS | STUDIO | ONE_BED | TWO_BED | THREE_PLUS_BED
// Application status: PENDING | APPROVED | REJECTED
// Applicant role: DRIVER | HELPER (see src/lib/applicantRoles.ts)
// Booking serviceType: SINGLE_ITEM | APARTMENT_HOUSE | STORAGE | OFFICE |
// DONATION | OTHER (see src/lib/serviceTypes.ts)
// payoutMethod: ZELLE | VENMO | APPLE_PAY (see src/lib/payoutMethods.ts)
// Booking serviceLine: LANDSCAPING | MOVING | JUNK (see src/lib/serviceLines.ts)
// Booking yardSize: SMALL | MEDIUM | LARGE | XL, landscapingService:
// MOW_EDGE_BLOW | CLEANUP | TRIM_HAUL | INSTALL, frequency: ONE_TIME | WEEKLY |
// BIWEEKLY | MONTHLY (all three: see src/lib/landscaping.ts)

model Driver {
  id            String    @id @default(cuid())
  name          String
  phone         String
  vehicle       String?
  payoutMethod  String?
  payoutHandle  String?
  active        Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())
  bookings      Booking[]
}

model DriverApplication {
  id           String   @id @default(cuid())
  status       String   @default("PENDING")

  name         String
  phone        String
  email        String?
  city         String?
  role         String?
  vehicle      String?
  payoutMethod String?
  payoutHandle String?
  availability String?
  notes        String?
  source       String?

  // Which recruiting page they came through — LANDSCAPING or MOVING (see
  // src/lib/serviceLines.ts; junk runs on the same trucks and the same people
  // as moving, so it isn't a separate pool to recruit for). Nullable because
  // every applicant before the two pages were split came through one combined
  // page and genuinely didn't say.
  line         String?

  createdAt    DateTime @default(now())
}

// A request to be introduced to licensed contractors — NOT a job we do.
//
// Deliberately its own table rather than a Booking with a flag. A Booking is
// work this company performs and takes money for; one of these is a referral
// out to an independent licensed contractor, with no price, no crew, no
// schedule and no payment. Sharing a table would mean every query about "our
// jobs" had to remember to exclude them, and the first one that forgot would
// put unlicensed work on the dispatch board.
//
// status: NEW | CONTACTED | MATCHED | CLOSED
model ContractorLead {
  id            String   @id @default(cuid())
  status        String   @default("NEW")

  name          String
  phone         String
  email         String?
  zip           String
  projectType   String
  preferredStart String?
  details       String?

  // Which marketing channel sent them, same as everywhere else.
  source        String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Booking {
  id              String    @id @default(cuid())
  status          String    @default("PENDING")

  customerName    String
  customerPhone   String
  customerEmail   String?

  pickupAddress   String
  // Nullable since not every job is a move: a dump run, a donation drop, or
  // help loading a container already in the driveway has one address. See
  // dropoffMode for which kind of job it is.
  dropoffAddress  String?
  dropoffMode     String?   @default("ADDRESS")
  moveDate        DateTime
  timeWindow      String
  city            String?

  // Set when the customer books through the map quote flow. Null for phone
  // bookings and for addresses typed as free text rather than picked from the
  // autocomplete, so dispatch can tell a mapped route from a hand-entered one.
  pickupLat       Float?
  pickupLng       Float?
  dropoffLat      Float?
  dropoffLng      Float?
  distanceMiles   Float?
  vehicleTier     String?

  // Which of the three businesses this job belongs to. It decides which of
  // the fields below mean anything: a yard job has yardSize and no vehicle
  // tier or route, a move has moveSize and a distance. Defaulted rather than
  // nullable so every booking taken before the landscaping pivot reads back
  // as what it was — a move.
  serviceLine     String    @default("MOVING")

  // Moving and junk jobs. Nullable since the landscaping pivot: a lawn has no
  // move size.
  moveSize        String?
  serviceType     String?
  serviceTypeOther String?
  needsHelper     Boolean   @default(true)

  // Landscaping jobs. The price is flat per (service x yard size), so unlike a
  // move there's no range: estimateLow and estimateHigh both hold the per-visit
  // price. frequency is what the customer signed up for — a recurring plan is
  // one Booking row for the first visit, with dispatch repeating it.
  landscapingService String?
  yardSize        String?
  frequency       String?

  details         String?
  // Which marketing channel this lead came from, tracked the same way as
  // DriverApplication.source: /book?source=<value>. See src/lib/sources.ts.
  source          String?

  estimateLow     Int
  estimateHigh    Int

  driverId        String?
  driver          Driver?   @relation(fields: [driverId], references: [id])
  dispatchNotes   String?

  // An unguessable link so a customer can cancel or ask to reschedule without
  // an account — see /manage/[token]. Generated with crypto.randomBytes, not
  // Prisma's cuid() default: a cuid is unique but not built to resist
  // guessing, and this one doubles as the only thing standing between a
  // stranger and someone else's booking.
  //
  // The database-side default is a backfill mechanism, not the normal path —
  // every booking the app creates passes an explicit randomBytes token (see
  // src/lib/manageToken.ts). It exists because this column is NOT NULL and
  // UNIQUE, and adding one of those to a table that already has rows is a
  // change Postgres cannot make on its own: there's no single value it could
  // put in every row without breaking the unique index. Prisma's answer was to
  // refuse the push and offer --force-reset, which drops the database — so
  // every deploy after this column was introduced failed, and production sat
  // two days stale on the last schema that didn't need it. gen_random_uuid()
  // is volatile, so Postgres evaluates it per row and each existing booking
  // gets its own token instead.
  manageToken     String    @unique @default(dbgenerated("gen_random_uuid()"))

  // Idempotency guards: both are set the moment their notification actually
  // sends, so a retried request or a re-run cron can't double-text someone.
  reminderSentAt      DateTime?
  reviewRequestSentAt DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
