generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// status/moveSize are plain strings rather than native Postgres enums so
// adding a new value never needs a migration. Valid values are enforced in
// the API routes (see src/lib/moveSizes.ts and
// the VALID_STATUSES lists in src/app/api/bookings/[id]/route.ts and
// src/app/api/applications/[id]/route.ts).
// Booking status: PENDING | ASSIGNED | IN_PROGRESS | COMPLETED | CANCELED
// MoveSize: FEW_ITEMS | STUDIO | ONE_BED | TWO_BED | THREE_PLUS_BED
// Application status: PENDING | APPROVED | REJECTED
// Applicant role: DRIVER | HELPER (see src/lib/applicantRoles.ts)
// Booking serviceType: SINGLE_ITEM | APARTMENT_HOUSE | STORAGE | OFFICE |
// DONATION | OTHER (see src/lib/serviceTypes.ts)
// payoutMethod: ZELLE | VENMO | APPLE_PAY (see src/lib/payoutMethods.ts)

model Driver {
  id            String    @id @default(cuid())
  name          String
  phone         String
  vehicle       String?
  payoutMethod  String?
  payoutHandle  String?
  active        Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())
  bookings      Booking[]
}

model DriverApplication {
  id           String   @id @default(cuid())
  status       String   @default("PENDING")

  name         String
  phone        String
  email        String?
  city         String?
  role         String?
  vehicle      String?
  payoutMethod String?
  payoutHandle String?
  availability String?
  notes        String?
  source       String?

  createdAt    DateTime @default(now())
}

model Booking {
  id              String    @id @default(cuid())
  status          String    @default("PENDING")

  customerName    String
  customerPhone   String
  customerEmail   String?

  pickupAddress   String
  dropoffAddress  String
  moveDate        DateTime
  timeWindow      String
  city            String?

  moveSize        String
  serviceType     String?
  serviceTypeOther String?
  needsHelper     Boolean   @default(true)
  details         String?

  estimateLow     Int
  estimateHigh    Int

  driverId        String?
  driver          Driver?   @relation(fields: [driverId], references: [id])
  dispatchNotes   String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
